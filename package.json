{
  "name": "canaryguard-402",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "node --env-file-if-exists=.env.local --import tsx src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "seed": "node --import tsx scripts/seed_payment.ts",
    "mcp": "node dist/stdio.js",
    "sales": "node --import tsx scripts/sales_tracker.ts"
  },
  "dependencies": {
    "@coinbase/x402": "^2.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/express": "2.28.0",
    "@x402/extensions": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/mcp": "2.28.0",
    "apify": "^3.7.2",
    "cheerio": "1.2.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "viem": "2.57.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
